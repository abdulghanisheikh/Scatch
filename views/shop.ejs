<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
    <div class="container relative flex flex-col w-full h-screen">
        <% if(msg.length>0){ %>
            <div class="bg-green-500 absolute top-[5%] left-1/2 -translate-x-[50%] -translate-y-[50%] w-fit rounded-lg p-3">
                <span class="text-white text-lg">
                    <%= msg %>
                </span>
            </div>
        <% } %>
        <% if(error.length>0){ %>
            <div class="bg-red-500 absolute top-[5%] left-1/2 -translate-x-[50%] -translate-y-[50%] w-fit rounded-lg p-3">
                <span class="text-white text-lg">
                    <%= error %>
                </span>
            </div>
        <% } %>
        <div class="navbar w-full px-5 py-4 flex justify-between items-center">
            <div class="logo">
                <h1 class="text-2xl">Scatch</h1>
            </div>
            <div class="links flex gap-5 items-center">
                <a href="/cart">Cart</a>
                <a href="/owner/admin">Admin</a>
                <a class="text-red-600" href="/user/logout">Logout</a>
            </div>
        </div>
        <div class="main flex w-full py-5 justify-between">
            <div class="sideBar w-[25%] flex flex-col justify-start items-start gap-30 px-10">
                <div class="flex gap-2 items-center mt-5">
                    <h3>Sort by:</h3>
                    <form method="get" action="/shop" class="flex flex-col justify-around">
                        <select onchange="this.form.submit()" class="px-3 py-1 w-fit border-[1px] rounded-lg border-black" name="sortby">
                            <option value="popular" <%= sortby==="popular"?"selected":"" %>>Popular</option>
                            <option value="newest" <%= sortby==="newest"?"selected":"" %>>Newest</option>
                        </select>
                    </form>
                </div>
                <div class="flex flex-col">
                    <a href="">New Collection</a>
                    <a href="">All Products</a>
                    <a href="">Discounted Products</a>
                </div>
                <div>
                    <h3 class="mb-2">Filter by:</h3>
                    <div class="flex flex-col">
                        <a href="">Availability</a>
                        <a href="">Discount</a>
                    </div>
                </div>
            </div>
            <div class="products w-[75%] flex items-start wrap min-h-screen shadow-md shadow-black-800 p-3">
                <% if(products){ %>
                    <% products.forEach((product,id)=>{ %>
                        <div class="product hover:scale-105 duration-300 ease-in-out px-5 h-82 flex flex-col overflow-hidden">
                            <div class="image bg-[<%=product.bgColor%>] rounded-t-xl">
                                <img src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" class="object-contain h-58 w-60" alt="Product Image">
                            </div>
                            <div class="panel text-[<%= product.textColor %>] flex justify-between items-center bg-[<%=product.panelColor%>] rounded-b-xl p-5">
                                <div class="flex flex-col">
                                    <h3><%= product.productName %></h3>
                                    <div class="flex gap-2 items-center">
                                        <h3>₹<%= product.price %></h3>
                                        <% if(product.discount>0){ %>
                                            <div class="w-fit h-fit rounded-full p-1 text-white bg-[<%= product.textColor %>]">
                                                <h3 class="text-xs">-₹<%= product.discount %></h3>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="h-fit w-fit bg-white rounded-full p-1">
                                    <a href="/addToCart/<%= product._id %>">
                                        <img src="../images/add-to-cart.png" height="30px" width="30px" alt="">
                                    </a>
                                </div>
                            </div>
                        </div>
                  <% }) %>        
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>