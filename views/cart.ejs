<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
    <div class="container relative flex flex-col w-full h-screen">
        <div class="navbar w-full px-5 py-4 flex justify-between items-center">
            <div class="logo">
                <h1 class="text-2xl">Scatch</h1>
            </div>
            <div class="links flex gap-5 items-center">
                <a href="/shop">Shop</a>
                <a href="/owner/admin">Admin</a>
                <a class="text-red-600" href="/user/logout">Logout</a>
            </div>
        </div>
        <div class="main w-full py-5 flex flex-col gap-10 items-center">
            <% if(products.length>0){ %>
                <% products.forEach((product,id)=>{ %>
                <div class="product hover:scale-102 duration-300 ease-in-out px-20 self-center w-3/4 h-130 flex gap-15 shadow-md p-1 rounded-md overflow-hidden">
                    <div class="profile w-[40%] flex flex-col text-[<%= product.textColor %>]">
                        <div class="image h-3/4 bg-[<%= product.bgColor %>] rounded-t-md">
                            <img class="object-contain h-full w-full" src="data:image/jpeg;base64,<%= product.image.toString('base64') %><%=  %>" alt="">
                        </div>
                        <div class="panel rounded-b-md overflow-hidden flex flex-col justify-between bg-[<%= product.panelColor %>] h-1/4 gap-2">
                            <h3 class="text-xl h-1/2 p-2"><%= product.productName %></h3>
                            <div class="flex h-1/2 p-4 justify-between text-white bg-[<%= product.textColor %>]">
                                <h4>Net Total</h4>
                                <h4>₹ <%= Number(product.price-product.discount+20) %></h4>
                            </div>
                        </div>
                    </div>
                    <div class="details flex flex-col w-[40%] gap-8">
                        <h1 class="text-xl">Price Breakdown</h1>
                        <div class="flex flex-col gap-2 mt-5">
                            <div class="flex justify-between items-center">
                                <h2>Total MRP</h2>
                                <h2>₹<%= Number(product.price) %></h2>
                            </div>
                            <div class="flex justify-between items-center">
                                <h2>Discount on MRP</h2>
                                <h2>₹ <%= Number(product.discount) %></h2>
                            </div>
                            <div class="flex justify-between items-center">
                                <h2>Platform Fee</h2>
                                <h2>₹ 20</h2>
                            </div>
                            <div class="flex justify-between items-center">
                                <h2>Shipping Fee</h2>
                                <h2>FREE</h2>
                            </div>
                        </div>
                        <hr class="w-full border-1">
                        <div class="flex justify-between text-lg items-center">
                            <h2>Total Amount</h2>
                            <h2 class="text-green-500 font-bold">₹ <%= Number(product.price-product.discount+20) %></h2>
                        </div>
                    </div>
                </div>
            <% }) %>
            <% }else{ %>
                <div>
                    <h1 class="text-xl">No Product Yet.</h1>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>


