<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
    <div class="container relative flex flex-col w-full h-screen">
        <div class="navbar w-full px-5 py-1 justify-between">
            <div class="logo">
                <h1 class="text-2xl">Scatch</h1>
            </div>
        </div>
        <div class="main flex w-full py-5">
            <div class="sideBar w-[20%] flex flex-col justify-start items-start px-10 py-10">
                <a href="">All Products</a>
                <a href="">Create new products</a>
            </div>
            <div class="createProduct w-[50%] flex flex-col justify-start items-start wrap min-h-screen shadow-md shadow-black-800 p-3 px-5">
                <h1 class="text-xl font-bold">Create New Product</h1>
                <h1 class="text-lg font-semibold">Product Details</h1>
                <form action="/owner/product/create" class="mt-5 flex flex-col w-full gap-5" method="post" enctype="multipart/form-data">
                    <div class="flex flex-col gap-5">
                        <div class="flex flex-col gap-1">
                            <h1 class="font-semibold">Product Image</h1>
                            <input type="file" name="imageFile" class="w-50 py-3 bg-zinc-200 border-1 px-2 outline-none rounded-lg cursor-pointer">
                        </div>
                        <div class="flex w-full wrap gap-5">
                            <input type="text" placeholder="Product Name" class="bg-zinc-200 p-2 rounded-lg w-1/3 outline-none hover:scale-103 duration-300 ease-in-out">
                            <input type="text" placeholder="Product Price" class="bg-zinc-200 p-2 rounded-lg w-1/3 outline-none hover:scale-103 duration-300 ease-in-out">
                            <input type="text" placeholder="Discount Price" class="bg-zinc-200 p-2 rounded-lg w-1/3 outline-none hover:scale-103 duration-300 ease-in-out">
                        </div>
                    </div>
                    <div class="flex flex-col gap-3">
                        <h1 class="font-semibold">Panel Details</h1>
                        <div class="flex w-full wrap gap-5">
                            <input type="text" placeholder="Background Color" class="bg-zinc-200 p-2 rounded-lg w-1/3 outline-none hover:scale-103 duration-300 ease-in-out">
                            <input type="text" placeholder="Panel Color" class="bg-zinc-200 p-2 rounded-lg w-1/3 outline-none hover:scale-103 duration-300 ease-in-out">
                            <input type="text" placeholder="Text Color" class="bg-zinc-200 p-2 rounded-lg w-1/3 outline-none hover:scale-103 duration-300 ease-in-out">
                        </div>
                    </div>
                    <button type="submit" class="p-4 mt-4 hover:scale-105 duration-300 ease-in-out shadow-lg hover:shadow-blue-300 rounded-lg bg-blue-500 cursor-pointer active:scale-95 text-white w-fit">Create New Product</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>