<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
    <div class="container relative flex flex-col w-full gap-15 min-h-screen">
        <% if(error.length>0){ %>
            <div class="bg-red-500 absolute top-[5%] left-1/2 -translate-x-[50%] -translate-y-[50%] w-fit rounded-lg p-3">
                <span class="text-white text-lg">
                    <%= error %>
                </span>
            </div>
        <% } %>
        <% if(msg.length>0){ %>
            <div class="bg-green-500 absolute top-[5%] left-1/2 -translate-x-[50%] -translate-y-[50%] w-fit rounded-lg p-3">
                <span class="text-white text-lg">
                    <%= msg %>
                </span>
            </div>
        <% } %>
        <div class="navbar w-full px-5 py-4 flex justify-between items-center">
            <div class="logo">
                <h1 class="text-2xl">Scatch</h1>
            </div>
        </div>
        <div class="main flex w-full gap-40 justify-center items-center">
            <div class="signup flex flex-col w-1/3 shadow-sm p-5 rounded-md">
                <div class="mb-3">
                    <h1 class="text-2xl">Welcome to <span class="text-blue-500 font-semibold">Scatch</span></h1>
                    <h1>create your account</h1>
                </div>
                <form action="/user/register" method="post" class="flex flex-col text-sm gap-3">
                    <input class="bg-zinc-100 hover:scale-103 duration-300 ease-in-out outline-none p-3 rounded-lg" type="text" name="fullName" placeholder="Fullname">
                    <input class="bg-zinc-100 hover:scale-103 duration-300 ease-in-out outline-none p-3 rounded-lg" type="email" name="email" placeholder="Email">
                    <input class="bg-zinc-100 hover:scale-103 duration-300 ease-in-out outline-none p-3 rounded-lg" type="password" name="password" placeholder="Password">
                    <button type="submit" class="p-4 mt-4 hover:scale-105 duration-300 ease-in-out shadow-lg hover:shadow-blue-300 rounded-full bg-blue-500 cursor-pointer active:scale-95 text-white w-fit">Create My Account</button>
                </form>
            </div>
            <div class="login flex flex-col w-1/3 mt-10 rounded-md p-5 shadow-sm">
                <h1 class="mb-3 text-lg">Login Your Account</h1>
                <form action="/user/login" method="post" class="flex flex-col text-sm gap-3">
                    <input class="bg-zinc-100 hover:scale-103 duration-300 ease-in-out outline-none p-3 rounded-lg" type="email" name="email" placeholder="Email">
                    <input class="bg-zinc-100 hover:scale-103 duration-300 ease-in-out outline-none p-3 rounded-lg" type="password" name="password" placeholder="Password">
                    <button type="submit" class="py-3 hover:scale-105 duration-300 ease-in-out shadow-lg hover:shadow-blue-300 px-6 mt-4 rounded-full bg-blue-500 cursor-pointer active:scale-95 text-white w-fit">Login</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>